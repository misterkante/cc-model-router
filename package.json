{
  "name": "cc-model-router",
  "version": "0.1.1",
  "description": "Automatic model routing for Claude Code: classify each task, pick the cheapest model that can do it, then verify and escalate when needed.",
  "type": "module",
  "bin": {
    "cc-model-router": "./bin/cc-model-router.js",
    "ccmr": "./bin/cc-model-router.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/misterkante/cc-model-router.git"
  },
  "homepage": "https://github.com/misterkante/cc-model-router",
  "bugs": {
    "url": "https://github.com/misterkante/cc-model-router/issues"
  },
  "author": "Gilchrist Kante (https://github.com/misterkante)",
  "files": [
    "bin",
    "src",
    "hooks",
    "examples",
    "scripts",
    "docs",
    "bench/README.md",
    "bench/README.fr.md",
    "bench/*.mjs",
    "bench/fixtures",
    "tests",
    "CHANGELOG.md",
    "CHANGELOG.fr.md",
    "CODE_OF_CONDUCT.md",
    "CODE_OF_CONDUCT.fr.md",
    "CONTRIBUTING.md",
    "CONTRIBUTING.fr.md",
    "IMPLEMENTATION_PLAN.md",
    "IMPLEMENTATION_PLAN.fr.md",
    "LICENSE",
    "README.md",
    "README.fr.md",
    "SECURITY.md",
    "SECURITY.fr.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "demo": "bash scripts/demo.sh",
    "prepublishOnly": "npm test && npm run docs:check",
    "bench": "node bench/run.mjs",
    "bench:verify": "node bench/verify.mjs",
    "bench:report": "node bench/report.mjs",
    "bench:publish": "node bench/publish.mjs",
    "bench:merge": "node bench/merge.mjs",
    "bench:recheck": "node bench/recheck.mjs",
    "bench:simulate-escalation": "node bench/simulate-escalation.mjs",
    "test:tui": "bash scripts/tui-smoke.sh",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "claude-code",
    "claude",
    "anthropic",
    "model-routing",
    "routing",
    "cost-optimization",
    "tokens",
    "llm",
    "cli",
    "benchmark"
  ]
}
